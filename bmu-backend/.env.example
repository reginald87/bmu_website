DEBUG=False
SECRET_KEY=your-secret-key-here-use-50-chars-minimum
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# Database (PostgreSQL recommended for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bmu_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-different-from-django-secret
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
# CSRF trusted origins (required in production for admin POSTs behind HTTPS)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Redis (required for production channel layer + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@bmu.edu.ng

# Links in outgoing emails point at the React frontend
FRONTEND_URL=https://yourdomain.com
# Internal alerts (comma-separated) for new applications
ADMISSIONS_OFFICE_EMAIL=admissions@bmu.edu.ng
# Error-reporting recipients (comma-separated; optional). Empty in dev.
ADMINS_EMAILS=

# Security (enable in production behind HTTPS proxy)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Paystack
# With a secret key set, transactions are verified against the Paystack API
# (amount + status) unless PAYSTACK_TEST_MODE=True, which skips verification
# and simulates success — local development only.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_TEST_MODE=False
